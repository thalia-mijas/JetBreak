# Environment variables for the backend application
JWT_SECRET=your_jwt_secret
PORT=3000
CACHE_TIME=86400 #Cache for 1 day

# API Keys
AVIATION_STACK_API_KEY=your_aviation_stack_api_key
FOURSQUARE_API_KEY=your_foursquare_api_key
AVIATION_EDGE_API_KEY=your_aviation_edge_api_key
AMADEUS_API_KEY=your_amadeus_api_key
AMADEUS_API_SECRET=your_amadeus_api_secret

# Email configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# Database configuration
NAME_DB=your_database_name
USER_DB=your_database_user
PASSWORD_DB=your_database_password
HOST_DB=your_database_host
PORT_DB=your_database_port