# Environment variables for the backend application
JWT_SECRET=your_jwt_secret
PORT=3000
CACHE_TIME=86400 #Cache for 1 day

# Frontend (orígenes permitidos por CORS, separados por coma)
# En producción: https://jet-break.vercel.app
FRONTEND_URL=http://localhost:5173

# API Keys
AVIATION_STACK_API_KEY=your_aviation_stack_api_key
FOURSQUARE_API_KEY=your_foursquare_api_key
AVIATION_EDGE_API_KEY=your_aviation_edge_api_key
AMADEUS_API_KEY=your_amadeus_api_key
AMADEUS_API_SECRET=your_amadeus_api_secret

# Email configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# Database — opción A (Railway / producción): URL completa
# DATABASE_URL=postgresql://user:password@host:5432/database

# Database — opción B (desarrollo local): variables individuales
NAME_DB=your_database_name
USER_DB=your_database_user
PASSWORD_DB=your_database_password
HOST_DB=your_database_host
PORT_DB=5432

# Redis (opcional). Si no se define, la app arranca sin caché.
# REDIS_URL=redis://default:password@host:6379

# Usuario de prueba (usado por scripts/seed-test-user.js y por el arranque de app.js)
# Pon SEED_TEST_USER=true para que app.js cree/actualice el usuario al iniciar.
SEED_TEST_USER=false
TEST_USER_EMAIL=demo@jetbreak.com
TEST_USER_PASSWORD=JetBreak2026!
TEST_USER_NAME=Usuario Demo
